{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://readthrough.fly.dev/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://readthrough.fly.dev/uploads/:path*"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
